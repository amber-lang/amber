// Output
// Succeeded
// Succeeded

import { file_compress, file_exists, file_extract, temp_dir_create } from "std/fs"

fun create_and_change_to_temp_dir(): Text? {
    const temp_dir = temp_dir_create("amber-test-stdlib-fs_file_extract_ab-XXXXX", true, true) failed {
        echo("It is not possible to create the temp directory")
        exit(1)
    }

    cd(temp_dir) failed {
        echo("It is not possible to access the {temp_dir} directory")
        fail(1)
    }

    return temp_dir
}

fun verify_format(format: Text): Bool? {
    // auto_delete would set an EXIT trap that replaces the parent one on each
    // call, so the directories are removed explicitly before returning.
    const dir_src = temp_dir_create("amber-test-stdlib-fs_file_extract-{format}-src-XXXXX") failed {
        echo("It is not possible to create the source directory")
        fail(2)
    }

    cd(dir_src) failed {
        echo("It is not possible to access the source directory")
        fail(3)
    }

    const test_filename = "test_{format}.txt"
    const test_file = test_filename

    touch(test_file) failed {
        echo("It is not possible to create the {test_file} file")
        fail(4)
    }

    const compress_file = "compress_{format}.{format}"

    file_compress([test_file], compress_file) failed {
        echo("It is not possible to create the \"{compress_file}\" file")
        fail(5)
    }
    
    const dir_dst = temp_dir_create("amber-test-stdlib-fs_file_extract-{format}-dst-XXXXX") failed {
        echo("It is not possible to create the destination directory")
        fail(6)
    }

    file_extract(compress_file, dir_dst) failed {
        echo("It is not possible to extract the \"{compress_file}\" file")
        fail(7)
    }

    const dir_dst_test_file = "{dir_dst}/{test_filename}"
    const is_file_extracted = file_exists(dir_dst_test_file)

    if not is_file_extracted {
        echo("The file {test_file} was not extracted from \"{format}\" format")
        fail(8)
    }

    trust silent $ rm -rf "{dir_src}" "{dir_dst}" $
    return true
}

main {
    create_and_change_to_temp_dir()?
    const formats = ["tar.gz", "zip"]

    let all_extracted = true

    for format in formats {
        const extracted = verify_format(format) failed(verify_format_error_code) {
            echo("{format}: Fail with error code: {verify_format_error_code}")
        }

        if not extracted: all_extracted = false
        else: echo("Succeeded")
    }

    if not all_extracted {
        fail(9)
    }
}
