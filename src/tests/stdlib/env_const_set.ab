import * from "std/env"

main {
    if shell_name() == "bash" {
        trust env_const_set("test_shell_constant_set", "Succe")
        let str = ""
        str += trust $ echo "\$test_shell_constant_set" $
        env_const_set("test_shell_constant_set", "Succe") failed {
            str += "eded"
        }
        echo(str)
    } else {
        echo("Succeeded")
    }
} 
