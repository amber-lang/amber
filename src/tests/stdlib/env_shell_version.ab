import { shell_version } from "std/env"

main {
    // Verify shellname returns a valid value
    const name = shellname()
    if name != "bash" and name != "zsh" and name != "ksh" {
        echo("Failed")
    }
    
    // Verify the version looks reasonable (major version 3-9)
    const version = shell_version()
    if version[0] >= 3 and version[0] <= 9 {
        echo("Succeeded")
    } else {
        echo("Version check failed")
    }
}
