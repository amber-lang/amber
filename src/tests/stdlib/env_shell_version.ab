main {
    // Verify shellname returns a valid value
    const name = shellname()
    if name != "bash" and name != "zsh" and name != "ksh" {
        echo("Failed")
    }
    
    // Verify the version looks reasonable (positive major version;
    // ksh93 reports 93 while bash/zsh report 1-9)
    const version = shellversion()
    if version[0] >= 1 and (version[0] <= 9 or name == "ksh") {
        echo("Succeeded")
    } else {
        echo("Version check failed")
    }
}
