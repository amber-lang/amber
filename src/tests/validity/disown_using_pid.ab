import { pgrep, kill } from "std/env"

main {
    trust silent $ killall yes $ // Cleanup before test

    trust $ yes > /dev/null 2>&1 & $
    const first_pid = pid()
    disown(first_pid)

    trust $ yes > /dev/null 2>&1 & $
    const second_pid = pid()

    trust $ yes > /dev/null 2>&1 & $
    const third_pid = pid()
    disown([second_pid, third_pid])

    kill(first_pid, "KILL")?
    kill(second_pid, "KILL")?
    kill(third_pid, "KILL")?
    if len(pgrep("yes")) == 0 {
        echo("Succeeded")
    } else {
        echo("Process still alive")
    }
}