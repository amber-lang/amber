main {
    // Ksh's `disown` command only stops SIGHUP and leaves the job in `jobs -l`
    // This is why we can't verify the ownership this way, so we skip ksh explicitly
    if shellname() == "ksh" {
        echo("Succeeded")
        exit(0)
    }

    trust silent $ killall yes $ // Cleanup before test

    trust $ yes > /dev/null 2>&1 & $
    const first_pid = pid()
    disown(first_pid)

    if len($ jobs -l $?) == 0 {
        trust $ yes > /dev/null 2>&1 & $
        const second_pid = pid()

        trust $ yes > /dev/null 2>&1 & $
        const third_pid = pid()
        disown([second_pid, third_pid])

        if len($ jobs -l $?) == 0 {
            echo("Succeeded")
        } else {
            echo("Process still owned")
        }
        trust silent $ kill {second_pid} {third_pid} $
    } else {
        echo("Process still owned")
    }

    trust silent $ kill {first_pid} $ // Cleanup after test
}
