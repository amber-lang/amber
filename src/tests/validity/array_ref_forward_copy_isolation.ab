// Output
// copy: 3 [one two shadow]
// after: 2 [one two]

fun mutate_copy(items: [Text]): Null {
    items += ["shadow"]
    echo("copy: {len(items)} [{items}]")
}

fun forward(ref items: [Text]): Null {
    mutate_copy(items)
    echo("after: {len(items)} [{items}]")
}

fun caller(): Null {
    let values = ["one", "two"]
    forward(values)
}

caller()
