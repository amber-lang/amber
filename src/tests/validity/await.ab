import { parse_int } from "std/text"

main {
    const start = trust $ date +%s $
    trust $ sleep 2 & $
    trust await(pid())
    const end = trust $ date +%s $
    const elapsed = parse_int(end)? - parse_int(start)?
    if elapsed >= 2 {
        echo("Succeeded")
    } else {
        echo("Didn't wait on sleep")
    }
}
