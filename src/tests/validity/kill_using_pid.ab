import { pgrep, kill } from "std/env"

main {
    trust $ killall yes $ // Cleanup before test

    trust $ yes > /dev/null 2>&1 & $
    disown()
    const yes_pid = pid()
    kill(yes_pid, "KILL")?
    if len(pgrep("yes")) == 0 {
        echo("Succeeded")
    } else {
        echo("Process still alive")
    }
}