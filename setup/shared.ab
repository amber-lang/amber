import { has_failed, is_root, env_var_get } from "std/env"
import { array_contains } from "std/array"

pub fun get_os(): Text {
    // Determine OS type
    const os_type = $ uname -s $ failed {
        echo("Failed to determine OS type (using `uname` command).")
        echo("Please try again or make sure you have it installed.")
        exit(1)
    }
    if os_type == "Darwin":
        return "macos"

    if os_type != "Linux" {
        echo("Unsupported OS type: {os_type}")
        echo("Please try again or use another download method.")
        exit(1)
    }

    if not has_failed("ls -l /lib | grep libc.musl"):
        return "linux-musl"

    return "linux-gnu"
}

pub fun get_arch(): Text {
    // Determine architecture
    const arch_type = $ uname -m $ failed {
        echo("Failed to determine architecture.")
        echo("Please try again or use another download method.")
        exit(1)
    }

    const arch = array_contains(["arm64", "aarch64"], arch_type)
        then "aarch64"
        else "x86_64"

    return arch
}

fun get_home(): Text {
    const home = env_var_get("HOME") failed {
        echo("User installation requested, but unable to retrieve home directory from $HOME environment.")
        exit(1)
    }
    if home == "" {
        echo("User installation requested, but unable to find home directory.")
        exit(1)
    }
    return home
}

pub fun get_bins_folder(user_only: Bool): Text {
    if user_only {
        return "{get_home()}/.local/bin"
    } else {
        // Ensure /usr/local/bin exists for non-user installations
        const bins_folder = "/usr/local/bin"
        silent $ [ -d "{bins_folder}" ] $ failed {
            silent $ {get_sudo_cmd()} mkdir -p "{bins_folder}" $ failed {
                echo("Failed to create {bins_folder} directory.")
                exit(1)
            }
        }
        return bins_folder
    }
}

pub fun get_place(user_only: Bool): Text {
    if user_only {
        return "{get_home()}/.local/lib/{get_arch()}/amber"
    } else {
        return "/opt/amber"
    }
}

pub fun get_sudo_cmd(): Text {
    if is_root() {
        return ""
    }
    if has_failed("command -v sudo") {
        return ""
    }
    return "sudo"
}
